; Engine configuration file.
; The project targets Godot 4.7.2 Stable. Keep the engine version pinned
; during the flight-model prototype unless a verified compatibility issue
; requires a deliberate upgrade.

config_version=5

[application]
config/name="Space Trucker - Phase 2A Prototype"
config/description="Cockpit interaction plus repulsorlift activation-state and telemetry HUD prototype."
run/main_scene="res://scenes/test_range.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":16,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
